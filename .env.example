# In production, generate e.g. with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Optional paths; defaults point into ./instance/
# DATABASE_PATH=/absolute/path/to/amstabase.sqlite
# UPLOAD_FOLDER=/absolute/path/to/uploads

# Optional fallback API key. A key entered in the admin UI is stored in the
# protected file below and takes precedence.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/absolute/path/to/openai_api_key
LLM_REQUEST_TIMEOUT_SECONDS=30
RECIPE_SOURCE_MAX_CHARS=50000
RECIPE_URL_MAX_BYTES=1000000

SESSION_LIFETIME_MINUTES=30
MAX_CONTENT_LENGTH=16777216
